{
  "name": "react-native-floating-glass-tabbar",
  "version": "0.1.0",
  "description": "Floating frosted-glass pill tab bar for React Native: a custom tabBar for React Navigation bottom tabs and expo-router, with a spring-animated indicator, label modes, badges, RTL and collapse-on-scroll.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-floating-glass-tabbar-source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "llms.txt",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-floating-glass-tabbar-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "android",
    "animated",
    "blur",
    "bottom-navigation",
    "bottom-tabs",
    "custom-tab-bar",
    "expo",
    "expo-blur",
    "expo-router",
    "floating",
    "glass",
    "glassmorphism",
    "ios",
    "liquid-glass",
    "navigation",
    "pill",
    "react-native",
    "react-native-tab-bar",
    "react-navigation",
    "tab-bar",
    "tabbar",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santhoshjamesc/react-native-floating-glass-tabbar.git"
  },
  "author": "Santhosh James <santhosh.james@adviciya.com> (https://github.com/santhoshjamesc)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/santhoshjamesc/react-native-floating-glass-tabbar/issues"
  },
  "homepage": "https://github.com/santhoshjamesc/react-native-floating-glass-tabbar#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-blur": "~57.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "test-renderer": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@react-navigation/bottom-tabs": ">=7.0.0",
    "expo-blur": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "react-native-floating-glass-tabbar-source"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  },
  "peerDependenciesMeta": {
    "@react-navigation/bottom-tabs": {
      "optional": true
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
